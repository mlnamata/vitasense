# Supabase — zkopírujte do .env.local a doplňte hodnoty z Project Settings → API.
# Dokud nejsou vyplněné, aplikace běží nad mock daty v lib/data/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Veřejná adresa webu (např. https://vitasense.cz) — pro odkazy a náhledy při sdílení.
NEXT_PUBLIC_SITE_URL=

# Přístup do /admin (HTTP Basic). Bez nich je admin v produkci zavřený,
# při `npm run dev` otevřený. Po napojení Supabase nahradí přihlášení s rolí.
ADMIN_USER=
ADMIN_PASSWORD=
